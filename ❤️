        I want a lifetime of
        <strong>"I'm glad I chose you."</strong>

    </p>


    <!-- CUTE LOVE STICKERS -->

    <div class="stickers">

        <div class="sticker">💌</div>

        <div class="sticker">🧸</div>

        <div class="sticker">🌹</div>

        <div class="sticker">💍</div>

    </div>


    <div class="question">
        Will you be my forever? ❤️
    </div>


    <!-- BUTTONS -->

    <div
        class="button-area"
        id="buttonArea"
    >

        <button
            class="action-button yes-button"
            id="yesButton"
        >
            YES, I WILL ❤️
        </button>


        <button
            class="action-button no-button"
            id="noButton"
        >
            No 🙈
        </button>

    </div>


    <div class="footer">

        Distance may separate us,
        but my heart already chose you. ❤️

    </div>

</section>



<!-- =====================================================
     SUCCESS
===================================================== -->

<section
    id="successScreen"
    class="success-screen"
>

    <div class="success-sticker">
