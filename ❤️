        </p>


        <br>


        <p>
            I wish I could be beside you right now,
            holding your hand and seeing that smile
            on your face.
        </p>


        <br>


        <p>
            Until the distance disappears,
            I'll keep choosing you —
            through every call,
            every message,
            every goodnight,
            and every little moment
            we share. 🌙
        </p>


        <br>


        <p>
            One day there will be
            <strong>no screens, no miles,
            and no goodbyes.</strong>

            Just you and me,
            building the life we dreamed about. 💍
        </p>


        <div class="signature">
            Forever yours... ❤️
        </div>

    </div>

</section>


</main>



<script>

/* =====================================================
   ELEMENTS
===================================================== */

const yesButton =
    document.getElementById("yesButton");

const noButton =
    document.getElementById("noButton");

const buttonArea =
    document.getElementById("buttonArea");

const questionScreen =
    document.getElementById("questionScreen");

const successScreen =
    document.getElementById("successScreen");


/* =====================================================
   NO BUTTON
   Keeps moving but YES stays fixed.
===================================================== */

function moveNoButton(){

    const area =
        buttonArea.getBoundingClientRect();

    const button =
        noButton.getBoundingClientRect();


    /*
       Keep the NO button inside
       the visible button area.
    */

    const maxX =
        area.width -
        button.width;

    const maxY =
        area.height -
        button.height;


    let x =
        Math.random() *
        Math.max(maxX,1);

    let y =
        Math.random() *
        Math.max(maxY,1);


    /*
       Prevent it from landing
       directly over YES.
    */

    const yes =
        yesButton.getBoundingClientRect();


    for(let i=0;i<10;i++){

        const testLeft =
            area.left + x;

        const testTop =
            area.top + y;

        const overlap =
            testLeft < yes.right &&
            testLeft + button.width > yes.left &&
            testTop < yes.bottom &&
            testTop + button.height > yes.top;


        if(!overlap){
            break;
        }


        x =
            Math.random() *
            Math.max(maxX,1);

        y =
            Math.random() *
            Math.max(maxY,1);
    }


    /*
       Use absolute positioning
       relative to button area.
    */

    noButton.style.position =
        "absolute";

    noButton.style.left =
        x + "px";

    noButton.style.top =
        y + "px";

    noButton.style.margin = "0";
}


/* Desktop */

noButton.addEventListener(
    "mouseenter",
    moveNoButton
);


/* Mobile touch */

noButton.addEventListener(
    "touchstart",
    function(event){

        event.preventDefault();

        moveNoButton();
    },
    {
        passive:false
    }
);


/* If somehow clicked */

noButton.addEventListener(
    "click",
    function(event){

        event.preventDefault();

        moveNoButton();
    }
);


/* =====================================================
   YES BUTTON
===================================================== */

yesButton.addEventListener(
    "click",
    function(){

        questionScreen.style.display =
            "none";

        successScreen.style.display =
            "block";


        /* Celebration */

        createHeartExplosion();

        createHeartBalloons();

        createSparkles();

    }
);


/* =====================================================
   HEART EXPLOSION
===================================================== */

function createHeartExplosion(){

    const symbols = [
        "❤️",
        "💗",
        "💕",
        "💖",
        "💘",
        "💞",
        "🌹",
        "💋"
    ];


    for(
        let i=0;
        i<60;
        i++
    ){

        const heart =
            document.createElement("div");


        heart.className =
            "burst-heart";


        heart.innerHTML =
            symbols[
                Math.floor(
                    Math.random() *
                    symbols.length
                )
            ];


        heart.style.left =
            "50%";

        heart.style.top =
            "50%";


        const x =
            (Math.random()-.5) *
            Math.min(
                window.innerWidth * 1.5,
                900
            );


        const y =
            (Math.random()-.5) *
            Math.min(
                window.innerHeight * 1.3,
                750
            );


        heart.style.setProperty(
            "--x",
            x + "px"
        );

        heart.style.setProperty(
            "--y",
            y + "px"
        );


        heart.style.fontSize =
            (15 +
            Math.random()*25)
            + "px";


        heart.style.animationDelay =
            Math.random() *
            .45
            + "s";


        document.body.appendChild(
            heart
        );


        setTimeout(
            function(){
                heart.remove();
            },
            3000
        );
    }
}


/* =====================================================
   HEART BALLOONS
===================================================== */

function createHeartBalloons(){

    const balloons = [
        "❤️",
        "💗",
        "💕",
        "💖",
        "💘",
        "❤️",
        "🌹",
        "💞",
        "💗",
        "❤️",
        "💖",
        "💕"
    ];


    balloons.forEach(
        function(item,index){

            setTimeout(
                function(){

                    const balloon =
                        document.createElement(
                            "div"
                        );


                    balloon.className =
                        "heart-balloon";


                    balloon.innerHTML =
                        item;


                    balloon.style.left =
                        (
                            Math.random()*94
                        ) + "vw";


                    balloon.style.fontSize =
                        (
                            38 +
                            Math.random()*38
                        ) + "px";


                    balloon.style.animationDuration =
                        (
                            5 +
                            Math.random()*4
                        ) + "s";


                    document.body.appendChild(
                        balloon
                    );


                    setTimeout(
                        function(){

                            balloon.remove();

                        },
                        10000
                    );

                },
                index * 220
            );
        }
    );
}


/* =====================================================
   SPARKLES
===================================================== */

function createSparkles(){

    const symbols = [
        "✦",
        "✧",
        "♡",
        "♥",
        "·"
    ];


    for(
        let i=0;
        i<45;
        i++
    ){

        setTimeout(
            function(){

                const sparkle =
                    document.createElement(
                        "div"
                    );


                sparkle.className =
                    "sparkle";


                sparkle.innerHTML =
                    symbols[
                        Math.floor(
                            Math.random() *
                            symbols.length
                        )
                    ];


                sparkle.style.left =
                    Math.random()*100
                    + "vw";


                sparkle.style.top =
                    15 +
                    Math.random()*70
                    + "vh";


                sparkle.style.fontSize =
                    (
                        12 +
                        Math.random()*18
                    ) + "px";


                document.body.appendChild(
                    sparkle
                );


                setTimeout(
                    function(){

                        sparkle.remove();

                    },
                    2000
                );

            },
            i * 80
        );
    }
}

</script>

</body>
</html>
